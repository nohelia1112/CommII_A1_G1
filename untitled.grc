- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\n# Activate your venv\
      \ first, then install\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.sync_block):\n\n\tdef __init__(self): # only default arguments here\n\
      \t\tgr.sync_block.__init__(\n\t\t\tself,\n\t\t\tname = 'e_Acum', # will show\
      \ up in GRC\n\t\t\tin_sig = [np.float32],\n\t\t\tout_sig = [np.float32]\n\t\t\
      )\n\t\tself.total = 0.0\n\n\tdef work(self, input_items, output_items):\n\t\t\
      x = input_items[0] # Senial de entrada .\n\t\ty0 = output_items[0] # Senial\
      \ acumulada\n\n\t\ty0[:] = np.cumsum(x)\n\t\t# self.total = y0[-1]\n\n\t\treturn\
      \ len(y0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Acum', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 280.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\n\tdef __init__(self):\
      \ # only default arguments here\n\t\tgr.sync_block.__init__(\n\t\t\tself,\n\t\
      \t\tname = 'e_Diff', # will show up in GRC\n\t\t\tin_sig = [np.float32],\n\t\
      \t\tout_sig = [np.float32]\n\t\t)\n\t\tself.acum_anterior = 0\n\t\t\n\n\tdef\
      \ work(self, input_items, output_items):\n\t\tx = input_items[0] # Senial de\
      \ entrada .\n\t\ty0 = output_items[0] # Senial acumulada diferencial\n\n\t\t\
      N = len(x)\n\n\t\tdiff = np.diff(np.concatenate([self.prev_value], x))\n\t\t\
      y0[:] = diff\n\n\t\tself.prev_value = x[-1]\n\n\t\treturn len(y0)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Diff', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 424.0]
    rotation: 0
    state: enabled
- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\n# Activate your venv\
      \ first, then install\n\nimport numpy as np\nfrom gnuradio import gr\n\nclass\
      \ blk(gr.sync_block):\n    def init (self): # only default arguments here\n\
      \        gr.sync_block.init(self,\n        name ='e_Acumm', # will show up in\
      \ GRC\n        in_sig =[np.float32],\n        out_sig =[np.float32]\n    )\n\
      \    def work(self , input_items , output_items ):\n        x = input_items[0]\
      \ # Senial de entrada .\n        y0 = output_items[0] # Senial acumulada\n \
      \       y0[:] = np.cumsum(x)\n        return len(y0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Acum', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
